---
import '../styles/global.css';
import type { Page } from '../content/config';
const { title, description, pageType } = Astro.props as Pick<Page, "title" | "description"> & { pageType: "dance" | "pilates" };
const isProduction = import.meta.env.PROD;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description ?? "Page description goes here"}>
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} - RushTopFish - Contemporary Dance in Austin, TX</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <!-- DANCE -->
        <link href="https://fonts.googleapis.com/css2?family=BenchNine:wght@700&display=swap&family=Signika+Negative:wght@300..700&display=swap" rel="stylesheet">

        <!-- PILATES -->
        <link href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,400;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,600&display=swap" rel="stylesheet">
	</head>
	<body class={pageType}>
	    <slot />
			{ isProduction &&
			<!-- Google tag (gtag.js) -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-Z8M30R4JJK"></script>
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-Z8M30R4JJK');
      </script>
      }
	</body>
</html>
