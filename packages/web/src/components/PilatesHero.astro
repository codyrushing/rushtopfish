---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from './Button.astro';
interface Props {
  eyebrow?: string;
  lede?: string;
  ledeInset?: boolean;
  image?: ImageMetadata;
  imageAlt?: string;
  caption?: string;
  primaryCtaText?: string;
  primaryCtaHref?: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
}

const {
  eyebrow = 'Reformer · Mat · Somatic',
  lede,
  ledeInset,
  image,
  imageAlt = '',
  caption
} = Astro.props;

---
<section class="hero container">
  <div class="hero-grid">
    <div class="copy">
      {eyebrow && <span class="hero-eyebrow">{eyebrow}</span>}
      <h1><slot name="heading" /></h1>
      {(lede || Astro.slots.has('lede')) && (
        <p class={`lede ${ledeInset ? 'max-w-[38ch]' : ''}`}>
          <slot name="lede">{lede}</slot>
        </p>
      )}
      <div class="actions">
        <slot name="actions" />
      </div>
    </div>

    { !!image && <div class="img-col">
      <div class="img-frame">
        <Image
          src={image}
          alt={imageAlt}
          widths={[600, 900, 1200]}
          sizes="(max-width: 860px) 100vw, 45vw"
        />
      </div>
      {caption && <div class="caption">{caption}</div>}
    </div>}

  </div>
</section>

<style>
  @import "../styles/global.css";
  .hero {
    @apply p-4 md:p-8;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    @apply gap-8;
    align-items: end;
  }

  .hero-eyebrow {
    font-size: 12px; font-weight: 600; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--color-smoke); display: block;
  }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 128px);
    line-height: 0.94; letter-spacing: -0.035em;
    margin: 14px 0 0;
    font-variation-settings: "opsz" 100, "SOFT" 90;
  }
  h1 :global(em) {
    font-style: italic;
    font-variation-settings: "opsz" 100, "SOFT" 100;
    color: var(--color-orange);
  }

  .lede {
    font-family: var(--font-serif); font-size: 22px;
    line-height: 1.45; color: var(--color-smoke);
    margin: 28px 0 0;
  }

  .actions { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
  .actions :global(.btn) { flex-shrink: 0; white-space: nowrap; }

  .img-frame { aspect-ratio: 4/5; overflow: hidden; }
  .img-frame :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .caption { font-size: 12px; color: var(--color-mist); margin-top: 10px; letter-spacing: 0.03em; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
  }
</style>
