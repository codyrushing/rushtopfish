---
import pilatesLogo from '../assets/logos/rtf-pilates.svg?url';
import Button from './Button.astro';
import InstagramLogo from '../assets/icons/instagram.svg';
import EnvelopeIcon from '../assets/icons/envelope.svg';

interface Props {
  activePage?: 'about' | 'book' | 'offerings' | 'info';
}

const { activePage } = Astro.props;

const navLinks = [
  { href: '/pilates/about',  label: 'About',  key: 'about' },
  { href: '/pilates/offerings', label: 'Offerings', key: 'offerings' },
  { href: '/pilates/info', label: 'Info', key: 'info' },
];

---
<header id="site-header" data-menu-state="closed">
  <div class="inner">
    <a class="brand" href="/pilates">
      <img src={pilatesLogo} alt="RushTopFish pilates" height="24">
    </a>

    <nav class="header-nav">
      <ul class="flex list-none gap-4 items-center p-0 m-0 text-sm">
        {navLinks.map(link => (
          <li>
            <a href={link.href} class:list={[{ active: activePage === link.key }]}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a
            class="ig p-2"
            href="https://instagram.com/rushtopfish.pilates"
            target="_blank"
            rel="noopener"
            aria-label="RushTopFish on Instagram"
          >
            <InstagramLogo class="w-5 h-5" />
          </a>
        </li>
      </ul>
    </nav>

    <div class="actions flex items-center gap-2">
      <Button type="button" href="/pilates/book">Book a class</Button>
      <button class="menu-toggle" data-menu-toggle type="button" aria-label="Open menu" aria-expanded="false" aria-controls="pilates-mobile-menu" id="pilates-menu-open">
        <!-- open icon -->
        <svg viewBox="0 0 24 24" class="open-icon" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>

        <!-- close icon -->
        <svg width="24" height="24" fill="none" viewBox="0 0 24 24" class="close-icon">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.25 6.75L6.75 17.25"/>
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6.75 6.75L17.25 17.25"/>
        </svg>

      </button>
    </div>

  </div>

  <div class="mobile-menu relative flex flex-col space-between" id="pilates-mobile-menu" role="dialog" aria-modal="true" aria-label="Site menu">
    <nav>
      <ul>
        {navLinks.map(link => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
        <li><a href="/pilates/book"><em>Book a class</em></a></li>
      </ul>
    </nav>
    <div class="foot mt-6 flex flex-col gap-4">
      <div class="flex flex-row justify-center items-center gap-4">
        <a class="ig" href="https://instagram.com/rushtopfish" target="_blank" rel="noopener">
          <InstagramLogo class="w-12 h-12" />
        </a>
        <a class="email" href="mailto:rushtopfish@gmail.com" target="_blank" rel="noopener">
          <EnvelopeIcon class="w-12 h-12" />
        </a>
      </div>
      <div class="text-center">
        <Button size="lg" variant="secondary" class="justify-center min-w-32" data-menu-toggle>Close</Button>
      </div>
    </div>
  </div>
</header>

<style>
@reference "tailwindcss";

#site-header {
  position: sticky; top: 0; z-index: 40;
  background: color-mix(in oklab, var(--color-cream) 88%, transparent);
  backdrop-filter: blur(10px);
  overflow: visible;
  @apply transition-all duration-200 ease-in-out;
}

#site-header[data-menu-state="open"] {
  @apply h-screen;
}

.inner {
  display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid var(--border-soft);
  @apply py-2 px-4;
}
.brand img { @apply -ml-1; height: 24px; display: block; }

nav ul {
  letter-spacing: 0.01em;
}
nav a {
  font-size: 17px;
  text-decoration: none; color: var(--color-ink);
  transition: color var(--duration-fast) var(--ease-out);
}
nav a:hover { text-decoration: underline; text-underline-offset: 0.35em; color: var(--color-ink); }
nav a.active { color: var(--color-orange); }

nav .ig {
  display: inline-flex; align-items: center; gap: 8px;
  text-decoration: none; color: var(--color-ink);
  transition: color var(--duration-fast) var(--ease-out);
}
nav .ig:hover { color: var(--color-orange); text-decoration: none; }

.menu-toggle {
  display: none; align-items: center; justify-content: center;
  width: 40px; height: 40px; margin-right: 4px; padding: 0;
  background: transparent; border: 1px solid var(--color-ink);
  border-radius: 999px; color: var(--color-ink); cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
}
/*.menu-toggle { background: var(--color-ink); color: var(--color-cream); }*/
.menu-toggle svg { width: 18px; height: 18px; display: block; }
.menu-toggle .close-icon { display: none; }
#site-header[data-menu-state="open"] .menu-toggle .close-icon {
  display: inline;
}
#site-header[data-menu-state="open"] .menu-toggle .open-icon {
  display: none;
}
.inner :global(.btn) { flex-shrink: 0; white-space: nowrap; }

/* Mobile menu overlay */

.mobile-menu {
  display: none; flex-direction: column;
  overflow-y: auto;
  flex-grow: 1;
  opacity: 0;
  scale: 0;
  @apply py-6 px-4 transition-all duration-200 ease-in-out;
}
#site-header[data-menu-state="open"] .mobile-menu {
  display: flex;
  scale: 1;
  opacity: 1;
}

.mobile-menu .top {
  display: flex; align-items: center; justify-content: space-between;
  padding-bottom: 28px;
  border-bottom: 1px solid var(--border-soft);
}
/*.close-toggle {
  display: inline-flex; align-items: center; justify-content: center;
  width: 40px; height: 40px;
  background: transparent; border: 1px solid var(--color-ink);
  border-radius: 999px; color: var(--color-ink); cursor: pointer;
  transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
}
.close-toggle:hover { background: var(--color-ink); color: var(--color-cream); }
.close-toggle svg { width: 18px; height: 18px; display: block; }*/

.mobile-menu nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
.mobile-menu nav a {
  display: block;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(36px, 9vw, 56px);
  line-height: 1.05; letter-spacing: -0.02em;
  color: var(--color-ink); text-decoration: none;
  padding: 14px 0;
  border-bottom: 1px solid var(--border-soft);
}
.mobile-menu nav a:hover { text-decoration: none; color: var(--color-ink); }
.mobile-menu nav a em { font-style: italic; color: var(--color-orange); }

.foot .ig {
  display: inline-flex; align-items: center; gap: 10px;
  color: var(--color-ink); text-decoration: none;
  font-size: 14px; letter-spacing: 0.02em;
}
/*.foot .ig svg { width: 18px; height: 18px; }*/
.foot .ig:hover { color: var(--color-ink); }
.visit { font-size: 13px; color: var(--color-smoke); line-height: 1.6; letter-spacing: 0.02em; margin: 0; }

@media (max-width: 860px) {
  .header-nav { display: none; }
  .menu-toggle { display: inline-flex; }
  .inner { padding: 12px 20px; gap: 12px; }
  .book-btn { padding: 10px 16px; font-size: 13px; }
}
</style>

<script>
  const siteHeader = document.getElementById('site-header');
  if (!siteHeader) {
    console.error("Site header not found, no element found for id 'site-header'")
  }
  const mobileMenu = document.getElementById('pilates-mobile-menu')


  let menuState: "open" | "closed" = siteHeader!.getAttribute("data-menu-state") === "closed" ? "closed" : "open";
  const toggleButtons = siteHeader!.querySelectorAll('[data-menu-toggle]');

  function openMenu() {
    menuState = "open";
    document.body.classList.add('menu-open');
    siteHeader?.setAttribute('data-menu-state', menuState);
  }

  function closeMenu() {
    menuState = "closed";
    document.body.classList.remove('menu-open');
    siteHeader?.setAttribute('data-menu-state', menuState);
  }

  for (const toggleButton of toggleButtons) {
    toggleButton.addEventListener("click", () => menuState === "closed" ? openMenu() : closeMenu());
  }

  mobileMenu?.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', closeMenu));
</script>
