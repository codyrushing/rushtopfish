---
import pilatesLogo from '../assets/logos/rtf-pilates.svg?url';
import Button from './Button.astro';

interface Props {
  activePage?: 'classes' | 'teachers' | 'schedule' | 'studio' | 'contact';
}

const { activePage } = Astro.props;

const navLinks = [
  { href: '#classes',  label: 'Classes',  key: 'classes' },
  { href: '#teachers', label: 'Teachers', key: 'teachers' },
  { href: '#schedule', label: 'Schedule', key: 'schedule' },
  { href: '#studio',   label: 'Studio',   key: 'studio' },
  { href: '#contact',  label: 'Contact',  key: 'contact' },
];
---

<header class="site-nav">
  <div class="inner">
    <a class="brand" href="/pilates">
      <img src={pilatesLogo} alt="RushTopFish pilates" height="24">
    </a>

    <nav>
      <ul>
        {navLinks.map(link => (
          <li>
            <a href={link.href} class:list={[{ active: activePage === link.key }]}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a
            class="ig"
            href="https://instagram.com/rushtopfish"
            target="_blank"
            rel="noopener"
            aria-label="RushTopFish on Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"/>
            </svg>
          </a>
        </li>
      </ul>
    </nav>

    <Button type="button" data-book="">Book a class</Button>

    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="pilates-mobile-menu" id="pilates-menu-open">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"/>
      </svg>
    </button>

  </div>
</header>

<div class="mobile-menu" id="pilates-mobile-menu" data-open="false" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="top">
    <a class="brand" href="/pilates">
      <img src={pilatesLogo} alt="RushTopFish pilates" height="24">
    </a>
    <button class="close-toggle" type="button" aria-label="Close menu" id="pilates-menu-close">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M6 18L18 6"/>
      </svg>
    </button>
  </div>
  <nav>
    <ul>
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
      <li><a href="#schedule" data-book=""><em>Book a class</em></a></li>
    </ul>
  </nav>
  <div class="foot">
    <a class="ig" href="https://instagram.com/rushtopfish" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="0.9" fill="currentColor" stroke="none"/>
      </svg>
      <span>@rushtopfish</span>
    </a>
    <p class="visit">2201 East Cesar · Austin, TX · Tue–Sat</p>
  </div>
</div>

<style>
  .site-nav {
    position: sticky; top: 0; z-index: 40;
    background: color-mix(in oklab, var(--color-cream) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-soft);
  }
  .inner {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 28px;
  }
  .brand img { height: 24px; display: block; }

  nav ul {
    list-style: none; display: flex; gap: 28px;
    padding: 0; margin: 0; font-size: 14px; letter-spacing: 0.01em;
  }
  nav a {
    text-decoration: none; color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-out);
  }
  nav a:hover { text-decoration: underline; text-underline-offset: 0.35em; color: var(--color-ink); }
  nav a.active { color: var(--color-orange); }

  nav .ig {
    display: inline-flex; align-items: center; gap: 8px;
    text-decoration: none; color: var(--color-ink);
    transition: color var(--duration-fast) var(--ease-out);
  }
  nav .ig:hover { color: var(--color-orange); text-decoration: none; }
  nav .ig svg { width: 18px; height: 18px; display: block; }

  .menu-toggle {
    display: none; align-items: center; justify-content: center;
    width: 40px; height: 40px; margin-right: 4px;
    background: transparent; border: 1px solid var(--color-ink);
    border-radius: 999px; color: var(--color-ink); cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .menu-toggle:hover { background: var(--color-ink); color: var(--color-cream); }
  .menu-toggle svg { width: 18px; height: 18px; display: block; }

  .inner :global(.btn) { flex-shrink: 0; white-space: nowrap; }

  /* Mobile menu overlay */
  .mobile-menu {
    position: fixed; inset: 0; z-index: 50;
    background: var(--color-cream);
    display: none; flex-direction: column;
    padding: 22px 28px 40px;
    overflow-y: auto;
  }
  .mobile-menu[data-open="true"] { display: flex; }

  .mobile-menu .top {
    display: flex; align-items: center; justify-content: space-between;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border-soft);
  }
  .close-toggle {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    background: transparent; border: 1px solid var(--color-ink);
    border-radius: 999px; color: var(--color-ink); cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }
  .close-toggle:hover { background: var(--color-ink); color: var(--color-cream); }
  .close-toggle svg { width: 18px; height: 18px; display: block; }

  .mobile-menu nav { margin-top: 36px; flex: 1; }
  .mobile-menu nav ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px; }
  .mobile-menu nav a {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(36px, 9vw, 56px);
    line-height: 1.05; letter-spacing: -0.02em;
    color: var(--color-ink); text-decoration: none;
    padding: 14px 0;
    border-bottom: 1px solid var(--border-soft);
  }
  .mobile-menu nav a:hover { text-decoration: none; color: var(--color-ink); }
  .mobile-menu nav a em { font-style: italic; color: var(--color-orange); }

  .foot { margin-top: 40px; display: flex; flex-direction: column; gap: 18px; }
  .foot .ig {
    display: inline-flex; align-items: center; gap: 10px;
    color: var(--color-ink); text-decoration: none;
    font-size: 14px; letter-spacing: 0.02em;
  }
  .foot .ig svg { width: 18px; height: 18px; }
  .foot .ig:hover { color: var(--color-ink); }
  .visit { font-size: 13px; color: var(--color-smoke); line-height: 1.6; letter-spacing: 0.02em; margin: 0; }

  @media (max-width: 860px) {
    nav { display: none; }
    .menu-toggle { display: inline-flex; }
    .inner { padding: 12px 20px; gap: 12px; }
    .book-btn { padding: 10px 16px; font-size: 13px; }
  }
</style>

<script>
  const openBtn = document.getElementById('pilates-menu-open');
  const closeBtn = document.getElementById('pilates-menu-close');
  const menu = document.getElementById('pilates-mobile-menu');

  function openMenu() {
    document.body.classList.add('menu-open');
    menu?.setAttribute('data-open', 'true');
    openBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    document.body.classList.remove('menu-open');
    menu?.setAttribute('data-open', 'false');
    openBtn?.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  menu?.querySelectorAll('a[href^="#"]').forEach(a => a.addEventListener('click', closeMenu));
</script>
