---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: {
    src: ImageMetadata | string;
    placement?: 'left' | 'right';
    alt?: string;
  }
}

const { image: { src, alt, placement="left" }={} } = Astro.props;

---

<article class="article-aside gap-6 py-6 md:py-8">
  <div class="img-col">
    { Astro.slots.has('image') && <slot name="image" /> }
    { !Astro.slots.has('image') && <div class={`aspect-[4/5] overflow-hidden ${placement === 'left' ? 'order-0' : 'order-1'}`}>
      <Image
        layout="constrained"
        src={src as ImageMetadata}
        alt={alt ?? ""}
        class="w-full h-full object-cover block" />
    </div> }
  </div>
  <div class="content-col">
    <slot name="content" />
  </div>
</article>

<style>
  @import "../styles/global.css";

  /* ------- Founders section ------- */
  .article-aside {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .article-aside + .article-aside { border-top: 1px solid var(--border-soft); }
  /*.article-asides .article-aside:nth-child(even) .img-col { order: 2; }*/

  @media (max-width: 860px) {
    .article-aside { grid-template-columns: 1fr; gap: 28px; }
    .img-col { order: 0; }
  }
</style>
