---
interface Props {
  attrs: {
    label: string,
    value: string
  }[]
}

const { attrs } = Astro.props;
---
<div class="grid gap-3 grid-cols-2">
  {
    attrs.map(
      ({label, value}) => <div class="p-2">
        <div class="eyebrow text-mist">{label}</div>
        <div>{value}</div>
      </div>
    )
  }
</div>
