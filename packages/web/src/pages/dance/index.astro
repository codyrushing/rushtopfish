---
import DanceLayout from 'src/layouts/DanceLayout.astro';
import bgImg from '../../assets/photos/dance-rooftop-together.jpeg';
import closeToTheChestFlyer from '../../assets/images/close-to-your-chest_flyer.png';
import { Image } from 'astro:assets';
import ArticleAside from 'src/components/ArticleAside.astro';
import Button from '../../components/Button.astro';

const gradientOverlay = [
  'linear-gradient(180deg,',
  '  rgba(14,12,10,0.78) 0%,',
  '  rgba(14,12,10,0.30) 28%,',
  '  rgba(14,12,10,0.20) 55%,',
  '  rgba(14,12,10,0.92) 100%',
  ')',
].join(' ');

---
<DanceLayout
  title="RushTopFish Dance — 2026 season, coming soon"
  description="RushTopFish is a contemporary dance company based in Austin, TX" theme="dance">

  <div class="container px-4 md:px-8 -mt-4">

    <ArticleAside image={{ src: closeToTheChestFlyer, alt: 'close to your chest'}}>
      <Fragment slot="content">
        <span class="eyebrow text-pink">Upcoming show</span>
        <h1 class="italic">close to your chest</h1>
        <p class="text-lg font-bold">Dec 17-21 2026</p>
        <p>
          <Button
            href="https://events.ticketleap.com/tickets/rushtopfish/close-to-your-chest"
            target="_blank"
            size="lg">
              TICKETS
            </Button>
        </p>
        <p class="flex flex-col">
          <strong>CRASHBOX</strong>
          <span>5305 Bolm Rd. #11 and #12</span>
          <span>Austin, TX 78721</span>
        </p>
        <Button
          href="https://www.google.com/maps/place/CRASHBOX/@30.2575732,-97.6938319,17z/data=!3m1!4b1!4m6!3m5!1s0x8644b7e8129d4669:0x6dbedbbfc1677c2b!8m2!3d30.2575732!4d-97.691257!16s%2Fg%2F11hzn4z258?entry=ttu&g_ep=EgoyMDI2MTExOC4xIKXMDSoASAFQAw%3D%3D"
          target="_blank"
          variant="ghost"
          size="sm">Directions</Button>
      </Fragment>
    </ArticleAside>
  </div>

</DanceLayout>
