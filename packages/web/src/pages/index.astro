---
import Layout from 'src/layouts/Layout.astro';
import { Image } from 'astro:assets';
import pilatesPhoto from '../assets/photos/pilates-gold-curtain-reach.jpg';
import dancePhoto from '../assets/photos/dance-rooftop-reach.jpg';
import logoBlack from '../assets/logos/rtf-black.svg?url';
import logoTricolor from '../assets/logos/rtf-tricolor.svg?url';
---

<Layout title="RushTopFish">
  <header class="top" id="top">
    <div class="eyebrow">A woman-owned movement organization</div>
    <div class="wordmark">
      <img src={logoBlack} alt="RushTopFish" class="logo black" />
      <img src={logoTricolor} alt="" class="logo tri" aria-hidden="true" />
    </div>
    <div class="fine">Est. 2024 · Austin, TX</div>
  </header>

  <main class="stage" id="stage" data-hover="">

    <a class="side pilates" href="/pilates">
      <Image
        src={pilatesPhoto}
        alt=""
        class="photo"
        widths={[800, 1200, 1800]}
        sizes="(max-width: 820px) 100vw, 50vw"
        layout="none"
      />
      <div class="wash" aria-hidden="true"></div>
      <div class="content">
        <span class="kicker">The studio</span>
        <h1>Pilates<!--<br><em>&amp; somatics</em>--></h1>
        <p>Reformer and mat classes taught by dancers, somatic therapists, and movement nerds who actually listen to your body.</p>
        <span class="enter">Enter the studio <span class="arrow">→</span></span>
      </div>
    </a>

    <a class="side dance" href="/dance">
      <Image
        src={dancePhoto}
        alt=""
        class="photo"
        widths={[800, 1200, 1800]}
        sizes="(max-width: 820px) 100vw, 50vw"
        layout="none"
      />
      <div class="wash" aria-hidden="true"></div>
      <div class="content">
        <span class="kicker">The company</span>
        <h1>Dance</h1>
        <p>A non-profit company making original work for bodies and cities. Season one, 2026.</p>
        <span class="enter">See the season <span class="arrow">→</span></span>
      </div>
    </a>

  </main>

  <div class="bottom">
    <div class="l pulse">One brand · two practices</div>
    <div class="r">rushtopfish.com</div>
  </div>
</Layout>

<style>
  :global(html),
  :global(body) {
    height: 100%;
    overflow: hidden;
  }
  :global(body) {
    background: var(--color-ink);
  }

  /* ── Fixed header ────────────────────────────────────────────────────── */
  .top {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 24px;
    padding: 24px 32px;
    pointer-events: none;
  }

  .top .eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-gold);
  }

  .top .wordmark {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .logo {
    height: 28px;
    width: auto;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .tri {
    position: absolute;
    opacity: 0;
  }

  .top.show-tri .black { opacity: 0; }
  .top.show-tri .tri   { opacity: 1; }

  .top .fine {
    text-align: right;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-sand);
    opacity: 0.7;
    font-weight: 500;
  }

  /* ── Split stage ─────────────────────────────────────────────────────── */
  .stage {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100vh;
    width: 100vw;
    transition: grid-template-columns var(--duration-slow) var(--ease-soft);
  }
  .stage[data-hover="pilates"] { grid-template-columns: 1.35fr 0.65fr; }
  .stage[data-hover="dance"]   { grid-template-columns: 0.65fr 1.35fr; }

  .side {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    padding: 64px;
    transition: padding var(--duration-slow) var(--ease-soft);
  }
  .side, .side:hover, .side:focus, .side * { text-decoration: none; }

  /* ── Photo (replaces CSS background-image) ───────────────────────────── */
  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    transition:
      transform var(--duration-slow) var(--ease-soft),
      filter    var(--duration-slow) var(--ease-soft),
      opacity   var(--duration-slow) var(--ease-soft);
  }

  .pilates .photo { filter: saturate(0.8) brightness(0.98); }
  .dance   .photo { filter: saturate(0.9) brightness(0.72); }
  .side:hover .photo { transform: scale(1.08); filter: none; }

  /* ── Color wash overlay ──────────────────────────────────────────────── */
  .wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition:
      opacity    var(--duration-slow) var(--ease-soft),
      background var(--duration-slow) var(--ease-soft);
  }

  .pilates .wash {
    background: linear-gradient(180deg,
      rgba(247,241,232,0.25) 0%,
      rgba(247,241,232,0)    35%,
      rgba(247,241,232,0.7)  100%);
  }
  .stage[data-hover="dance"] .pilates .wash {
    background: linear-gradient(180deg,
      rgba(23,19,16,0.55) 0%,
      rgba(23,19,16,0.55) 100%);
  }

  .dance .wash {
    background: linear-gradient(180deg,
      rgba(14,12,10,0.2)  0%,
      rgba(14,12,10,0)    30%,
      rgba(14,12,10,0.78) 100%);
  }
  .stage[data-hover="pilates"] .dance .wash {
    background: linear-gradient(180deg,
      rgba(14,12,10,0.7)  0%,
      rgba(14,12,10,0.82) 100%);
  }

  /* ── Side content ────────────────────────────────────────────────────── */
  .content {
    position: relative;
    z-index: 2;
    max-width: 620px;
    width: 100%;
  }

  .stage[data-hover="dance"]   .pilates .content,
  .stage[data-hover="pilates"] .dance .content {
    opacity: 0.42;
    transition: opacity var(--duration-slow) var(--ease-soft);
  }

  .kicker {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .kicker::before {
    content: "";
    width: 28px;
    height: 1.5px;
    background: currentColor;
    display: inline-block;
    transition: width var(--duration-slow) var(--ease-soft);
  }
  .side:hover .kicker::before { width: 48px; }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(48px, 6.4vw, 112px);
    line-height: 0.9;
    letter-spacing: -0.035em;
    margin: 18px 0 24px;
    transition: color var(--duration-slow) var(--ease-soft);
  }
  h1 em { font-style: italic; }

  .content p {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    max-width: 38ch;
    margin: 0 0 32px;
  }

  .enter {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.02em;
    padding: 14px 26px;
    border-radius: 999px;
    white-space: nowrap;
    border: 1.5px solid transparent;
    transition:
      background var(--duration-base) var(--ease-out),
      color      var(--duration-base) var(--ease-out),
      transform  var(--duration-base) var(--ease-soft);
  }

  .arrow {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-soft);
  }
  .side:hover .arrow { transform: translateX(6px); }

  /* ── Pilates palette ─────────────────────────────────────────────────── */
  .pilates              { color: var(--color-ink); }
  .pilates .kicker      { color: var(--color-orange); }
  .pilates h1           { color: var(--color-ink); }
  .pilates .content p   { color: var(--color-smoke); }
  .pilates .enter       { background: var(--color-ink);    color: var(--color-cream); }
  .pilates:hover .enter { background: var(--color-orange); color: #fff; }

  /* ── Dance palette ───────────────────────────────────────────────────── */
  .dance              { color: var(--color-cream); }
  .dance .kicker      { color: var(--color-pink); }
  .dance h1           { color: var(--color-cream); }
  .dance h1 em        { color: var(--color-pink); }
  .dance .content p   { color: color-mix(in oklab, var(--color-cream) 72%, transparent); }
  .dance .enter       { background: var(--color-pink);  color: var(--color-ink); }
  .dance:hover .enter { background: var(--color-cream); color: var(--color-ink); }

  /* ── Bottom strip ────────────────────────────────────────────────────── */
  .bottom {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 20;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 32px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .bottom .l { color: var(--color-smoke); }
  .bottom .r { color: var(--color-sand); opacity: 0.72; }

  .pulse {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pulse::before {
    content: "";
    width: 6px; height: 6px;
    border-radius: 999px;
    background: var(--color-gold);
    display: inline-block;
    animation: pulse 2.4s var(--ease-soft) infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.35; transform: scale(1); }
    50%       { opacity: 1;   transform: scale(1.4); }
  }

  /* ── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 820px) {
    :global(html),
    :global(body) { overflow: auto; }

    .stage { grid-template-columns: 1fr; height: auto; }
    .stage[data-hover] { grid-template-columns: 1fr; }
    .side { min-height: 60vh; padding: 80px 28px 48px; }
    h1 { font-size: clamp(44px, 12vw, 80px); }
    .seam, .seam-badge { display: none; }
    .top { padding: 16px 20px; grid-template-columns: 1fr; }
    .top .eyebrow, .top .fine { display: none; }
    .bottom {
      position: static;
      padding: 20px 20px 28px;
      background: var(--color-ink);
      color: var(--color-cream);
    }
  }
</style>

<script>
  const stage = document.getElementById('stage') as HTMLElement;
  const topEl  = document.getElementById('top')   as HTMLElement;

  function setHover(name: string) {
    stage.setAttribute('data-hover', name);
    topEl.classList.toggle('show-tri', !!name);
  }

  document.querySelectorAll<HTMLElement>('.side').forEach(side => {
    const name = side.classList.contains('pilates') ? 'pilates' : 'dance';
    side.addEventListener('mouseenter', () => setHover(name));
    side.addEventListener('mouseleave', () => setHover(''));
    side.addEventListener('focus',      () => setHover(name));
    side.addEventListener('blur',       () => setHover(''));
  });
</script>
