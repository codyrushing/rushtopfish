---
import PilatesHero from '../../components/PilatesHero.astro';
import ArticleAside from '../../components/ArticleAside.astro';

import pilatesMatPhoto from '../../assets/photos/pilates-mat-stretch-sunlit.jpg';
import PilatesLayout from 'src/layouts/PilatesLayout.astro';

import PhotoStrip from '../../components/PhotoStrip.astro';
import socksPointImg from '../../assets/photos/pilates-socks-point.jpg';
import outsideBackbendImg from '../../assets/photos/outside-backbend.jpg';
import carissaSunlight from '../../assets/photos/carissa-sunlight.jpg';
import reformerBridgeImg from '../../assets/photos/pilates-reformer-bridge.jpg';
import seatedLegRaise from '../../assets/photos/pilates-15.jpg';
import carissaEmBackToBackImg from '../../assets/photos/carissa-em-back-to-back.jpg'

import carissaPortrait from '../../assets/photos/pilates-portrait-smile.jpg';

---

<PilatesLayout title="About Us - RushTopFish Pilates" theme="pilates" pageType="pilates">

  <PilatesHero
    eyebrow="About Us"
    image={carissaEmBackToBackImg}
    imageAlt="Emily Rushing and Carissa Topham-Fisher"
    caption="Morning mat class · Studio A"
  >
    <Fragment slot="heading">Who <em>we are</em></Fragment>
    <Fragment slot="lede"><strong>RushTopFish</strong> is the professional collaboration between Emily Rushing and Carissa Topham Fisher. We are a woman-owned organization that offers Pilates and Somatic based fitness classes to our community. We offer both mat and reformer classes for a variety of levels/ workout intensities, and our classes are a fusion of all of our professional knowledge from many years of being pilates instructors, professional dancers, somatic experts and movement enthusiasts.</Fragment>
  </PilatesHero>

  <div class="container">
    <ArticleAside image={{ src: carissaPortrait, alt: 'Carissa Topham-Fisher'}}>
      <Fragment slot="content">
        <div class="bio">
          <span class="eyebrow text-orange">Cofounder</span>
          <h2>Carissa Topham-Fisher</h2>
          <!-- <p class="role">Reformer · somatic</p> -->
          <p>Marin opened RushTopFish in 2022, in a 600-square-foot warehouse with a single reformer she'd refurbished herself. She'd spent ten years teaching pilates around Austin and was tired of teaching the way studios wanted her to teach — fast, packed, scripted.</p>
          <p>Her training is in contemporary dance, with an MFA from the University of Texas, and she came to pilates in her late twenties as a way back into her body after a stage injury. That route — through pain, through dance, through somatic work — is still the lens she teaches from. She's certified through STOTT and is a Somatic Experiencing Practitioner.</p>
          <p>Marin teaches the Tuesday slow-flow reformer and the Friday deep-stretch mat. Outside the studio she's a mediocre swimmer, an excellent listener, and the person who chose every chair in the lobby.</p>
          <div class="certs">STOTT · Somatic Experiencing Practitioner · MFA Dance · 12 yrs teaching</div>
        </div>
      </Fragment>
    </ArticleAside>
  </div>

</PilatesLayout>

<style>
@import "../../styles/global.css";

.bio .eyebrow {
  font-size: 11px; font-weight: 600; letter-spacing: 0.18em;
  text-transform: uppercase;
  display: block; margin-bottom: 10px;
}
.bio h2 {
  font-family: var(--font-display);
  font-size: clamp(40px, 4.5vw, 64px);
  line-height: 1.02;
  letter-spacing: -0.02em;
  margin: 0 0 6px;
  font-weight: 400;
}
.bio .role {
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 18px;
  @apply text-smoke;
  margin: 0 0 26px;
}
.bio p {
  font-size: 16px;
  line-height: 1.75;
  margin: 0 0 16px;
  @apply text-ink;
}

.bio .certs {
  margin-top: 22px;
  padding-top: 16px;
  border-top: 1px solid var(--border-soft);
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.04em;
  @apply text-mist;
}

</style>
